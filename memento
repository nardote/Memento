#!/usr/bin/env python3
from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import re
import secrets
import sys
import hmac
import hashlib
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from typing import Any

VERSION = "0.1.0"
CROCKFORD = "0123456789ABCDEFGHJKMNPQRSTVWXYZ"


def ulid() -> str:
    value = (int(dt.datetime.now(dt.timezone.utc).timestamp() * 1000) << 80) | secrets.randbits(80)
    chars = []
    for _ in range(26):
        chars.append(CROCKFORD[value & 31])
        value >>= 5
    return "".join(reversed(chars))


def slugify(value: str) -> str:
    value = value.lower().strip()
    value = re.sub(r"[^a-z0-9]+", "-", value).strip("-")
    return value[:60] or "memory"


def locate_root(explicit: str | None = None, create: bool = False) -> Path:
    if explicit:
        root = Path(explicit).expanduser().resolve()
    elif os.environ.get("MEMENTO_HOME"):
        root = Path(os.environ["MEMENTO_HOME"]).expanduser().resolve()
    else:
        current = Path.cwd().resolve()
        root = next((p / ".memory" for p in (current, *current.parents) if (p / ".memory").is_dir()), current / ".memory")
    if create:
        (root / "projects").mkdir(parents=True, exist_ok=True)
        (root / "deleted").mkdir(parents=True, exist_ok=True)
        config = root / "config.json"
        if not config.exists():
            config.write_text(json.dumps({"version": 1}, indent=2) + "\n", encoding="utf-8")
    return root


def encode_memory(meta: dict[str, Any], content: str) -> str:
    return "---\n" + json.dumps(meta, ensure_ascii=False, indent=2) + "\n---\n\n" + content.strip() + "\n"


def decode_memory(path: Path) -> dict[str, Any]:
    raw = path.read_text(encoding="utf-8")
    match = re.match(r"^---\n(.*?)\n---\n\n?(.*)$", raw, re.DOTALL)
    if not match:
        raise ValueError(f"formato inválido: {path}")
    meta = json.loads(match.group(1))
    meta["content"] = match.group(2).rstrip()
    meta["path"] = str(path)
    return meta


def memory_files(root: Path, project: str | None = None):
    base = root / "projects"
    if project:
        base = base / project
    if not base.exists():
        return
    deleted = {p.name for p in (root / "deleted").glob("*")}
    for path in base.rglob("*.md"):
        try:
            item = decode_memory(path)
            if item.get("id") not in deleted:
                yield item
        except (ValueError, OSError, json.JSONDecodeError):
            continue


def save_memory(root: Path, project: str, title: str, content: str, kind: str = "note", tags=None, author=None) -> dict[str, Any]:
    root = locate_root(str(root), create=True)
    now = dt.datetime.now().astimezone()
    memory_id = ulid()
    meta = {
        "id": memory_id,
        "project": project,
        "type": kind,
        "title": title,
        "created_at": now.isoformat(timespec="seconds"),
        "author": author or os.environ.get("USER", "unknown"),
        "tags": tags or [],
    }
    directory = root / "projects" / project / now.strftime("%Y") / now.strftime("%m")
    directory.mkdir(parents=True, exist_ok=True)
    path = directory / f"{memory_id}-{slugify(title)}.md"
    path.write_text(encode_memory(meta, content), encoding="utf-8")
    return decode_memory(path)


def search_memories(root: Path, query: str, project: str | None = None, limit: int = 20) -> list[dict[str, Any]]:
    terms = [term.casefold() for term in query.split() if term]
    found = []
    for item in memory_files(root, project) or []:
        haystack = " ".join([item.get("title", ""), item.get("content", ""), " ".join(item.get("tags", []))]).casefold()
        score = sum(haystack.count(term) for term in terms)
        if not terms or score:
            item["score"] = score
            found.append(item)
    found.sort(key=lambda x: (x["score"], x.get("created_at", "")), reverse=True)
    return found[:limit]


def find_memory(root: Path, memory_id: str) -> dict[str, Any] | None:
    return next((item for item in memory_files(root) or [] if item.get("id") == memory_id), None)


def delete_memory(root: Path, memory_id: str) -> bool:
    if not find_memory(root, memory_id):
        return False
    deleted = root / "deleted"
    deleted.mkdir(parents=True, exist_ok=True)
    (deleted / memory_id).write_text(dt.datetime.now().astimezone().isoformat() + "\n", encoding="utf-8")
    return True


def token_hash(token: str) -> str:
    return "sha256:" + hashlib.sha256(token.encode("utf-8")).hexdigest()


def users_path(root: Path) -> Path:
    return root / "users.json"


def load_users(root: Path) -> list[dict[str, Any]]:
    path = users_path(root)
    if not path.exists():
        return []
    data = json.loads(path.read_text(encoding="utf-8"))
    return data.get("users", [])


def write_users(root: Path, users: list[dict[str, Any]]) -> None:
    locate_root(str(root), create=True)
    path = users_path(root)
    temporary = path.with_suffix(".tmp")
    temporary.write_text(json.dumps({"version": 1, "users": users}, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    os.chmod(temporary, 0o600)
    temporary.replace(path)


def create_user(root: Path, username: str, role: str, projects: list[str], token: str | None = None) -> str:
    if role not in ("admin", "writer", "reader"):
        raise ValueError("rol inválido")
    if not re.fullmatch(r"[a-zA-Z0-9_.-]{1,64}", username):
        raise ValueError("nombre de usuario inválido")
    users = load_users(root)
    if any(user["username"] == username and user.get("active", True) for user in users):
        raise ValueError("el usuario ya existe")
    raw = token or secrets.token_urlsafe(48)
    if len(raw) < 32:
        raise ValueError("el token debe tener al menos 32 caracteres")
    users.append({
        "username": username,
        "role": role,
        "projects": projects or [],
        "token_hash": token_hash(raw),
        "active": True,
        "created_at": dt.datetime.now().astimezone().isoformat(timespec="seconds"),
    })
    write_users(root, users)
    audit(root, username, "user.created", None, {"role": role, "projects": projects})
    return raw


def authenticate(root: Path, token: str) -> dict[str, Any] | None:
    digest = token_hash(token)
    for user in load_users(root):
        if user.get("active", True) and hmac.compare_digest(user.get("token_hash", ""), digest):
            return user
    return None


def project_allowed(user: dict[str, Any], project: str) -> bool:
    return "*" in user.get("projects", []) or project in user.get("projects", [])


def require_access(user: dict[str, Any], project: str, write: bool = False, admin: bool = False) -> None:
    if admin and user.get("role") != "admin":
        raise PermissionError("se requiere rol admin")
    if write and user.get("role") not in ("admin", "writer"):
        raise PermissionError("el usuario es de sólo lectura")
    if not project_allowed(user, project):
        raise PermissionError(f"sin acceso al proyecto: {project}")


def audit(root: Path, actor: str, action: str, project: str | None, details: dict[str, Any]) -> None:
    now = dt.datetime.now().astimezone()
    directory = root / "audit"
    directory.mkdir(parents=True, exist_ok=True)
    event = {"id": ulid(), "timestamp": now.isoformat(timespec="seconds"), "actor": actor, "action": action, "project": project, "details": details}
    with (directory / now.strftime("%Y-%m.jsonl")).open("a", encoding="utf-8") as stream:
        stream.write(json.dumps(event, ensure_ascii=False) + "\n")


def public(item: dict[str, Any]) -> dict[str, Any]:
    return {key: value for key, value in item.items() if key != "path"}


TOOLS = [
    {"name": "activity_add", "description": "Registra una actividad inmutable", "inputSchema": {"type": "object", "required": ["project", "action", "details"], "properties": {"project": {"type": "string"}, "action": {"type": "string"}, "details": {"type": "string"}, "tags": {"type": "array", "items": {"type": "string"}}}}},
    {"name": "activity_list", "description": "Lista actividades recientes", "inputSchema": {"type": "object", "required": ["project"], "properties": {"project": {"type": "string"}, "limit": {"type": "integer"}, "actor": {"type": "string"}}}},
    {"name": "activity_search", "description": "Busca actividades", "inputSchema": {"type": "object", "required": ["project", "query"], "properties": {"project": {"type": "string"}, "query": {"type": "string"}, "limit": {"type": "integer"}, "actor": {"type": "string"}}}},
    {"name": "memory_save", "description": "Guarda una memoria Markdown", "inputSchema": {"type": "object", "required": ["project", "title", "content"], "properties": {"project": {"type": "string"}, "title": {"type": "string"}, "content": {"type": "string"}, "type": {"type": "string"}, "tags": {"type": "array", "items": {"type": "string"}}}}},
    {"name": "memory_search", "description": "Busca memorias por texto", "inputSchema": {"type": "object", "required": ["query"], "properties": {"query": {"type": "string"}, "project": {"type": "string"}, "limit": {"type": "integer"}}}},
    {"name": "memory_get", "description": "Obtiene una memoria por ID", "inputSchema": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}}}},
    {"name": "memory_context", "description": "Devuelve las memorias recientes de un proyecto", "inputSchema": {"type": "object", "required": ["project"], "properties": {"project": {"type": "string"}, "limit": {"type": "integer"}}}},
    {"name": "memory_delete", "description": "Crea un tombstone para una memoria", "inputSchema": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}}}},
]


def mcp_call(root: Path, name: str, args: dict[str, Any], principal: dict[str, Any] | None = None) -> Any:
    user = principal or {"username": "local", "role": "admin", "projects": ["*"]}
    if name == "activity_add":
        require_access(user, args["project"], write=True)
        item = save_memory(root, args["project"], args["action"], args["details"], "activity", args.get("tags", []), user["username"])
        audit(root, user["username"], "activity.add", args["project"], {"id": item["id"], "action": args["action"]})
        return public(item)
    if name in ("activity_list", "activity_search"):
        require_access(user, args["project"])
        query = args.get("query", "") if name == "activity_search" else ""
        items = search_memories(root, query, args["project"], args.get("limit", 20))
        items = [item for item in items if item.get("type") == "activity" and (not args.get("actor") or item.get("author") == args["actor"])]
        return [public(x) for x in items[: args.get("limit", 20)]]
    if name == "memory_save":
        require_access(user, args["project"], write=True)
        return public(save_memory(root, args["project"], args["title"], args["content"], args.get("type", "note"), args.get("tags", []), user["username"]))
    if name == "memory_search":
        project = args.get("project")
        if project:
            require_access(user, project)
        items = search_memories(root, args["query"], project, args.get("limit", 20))
        return [public(x) for x in items if project_allowed(user, x["project"])]
    if name == "memory_get":
        item = find_memory(root, args["id"])
        if item:
            require_access(user, item["project"])
        return public(item) if item else None
    if name == "memory_context":
        require_access(user, args["project"])
        items = list(memory_files(root, args["project"]) or [])
        items.sort(key=lambda x: x.get("created_at", ""), reverse=True)
        return [public(x) for x in items[: args.get("limit", 20)]]
    if name == "memory_delete":
        item = find_memory(root, args["id"])
        if item:
            require_access(user, item["project"], admin=True)
        return {"deleted": delete_memory(root, args["id"])}
    raise ValueError(f"herramienta desconocida: {name}")


def rpc_response(root: Path, request: dict[str, Any], principal: dict[str, Any] | None = None) -> dict[str, Any] | None:
    if "id" not in request:
        return None
    method = request.get("method")
    if method == "initialize":
        requested = request.get("params", {}).get("protocolVersion", "2025-06-18")
        protocol = requested if requested in ("2024-11-05", "2025-03-26", "2025-06-18") else "2025-06-18"
        result = {"protocolVersion": protocol, "capabilities": {"tools": {}}, "serverInfo": {"name": "memento", "version": VERSION}}
    elif method == "tools/list":
        result = {"tools": TOOLS}
    elif method == "tools/call":
        params = request.get("params", {})
        value = mcp_call(root, params.get("name", ""), params.get("arguments", {}), principal)
        result = {"content": [{"type": "text", "text": json.dumps(value, ensure_ascii=False)}]}
    elif method == "ping":
        result = {}
    else:
        raise ValueError(f"método desconocido: {method}")
    return {"jsonrpc": "2.0", "id": request["id"], "result": result}


def serve_mcp(root: Path) -> None:
    principal = None
    if load_users(root):
        principal = authenticate(root, os.environ.get("MEMENTO_TOKEN", ""))
        if not principal:
            raise SystemExit("MEMENTO_TOKEN ausente o inválido para este almacén")
    for line in sys.stdin:
        request: dict[str, Any] = {}
        try:
            request = json.loads(line)
            response = rpc_response(root, request, principal)
            if response is None:
                continue
        except Exception as exc:
            response = {"jsonrpc": "2.0", "id": request.get("id") if isinstance(request, dict) else None, "error": {"code": -32603, "message": str(exc)}}
        print(json.dumps(response, ensure_ascii=False), flush=True)


def serve_http(root: Path, host: str, port: int, allowed_origins: set[str]) -> None:
    class Handler(BaseHTTPRequestHandler):
        server_version = "Memento/" + VERSION

        def send_json(self, status: int, value: Any) -> None:
            body = json.dumps(value, ensure_ascii=False).encode("utf-8")
            self.send_response(status)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def principal(self) -> dict[str, Any] | None:
            header = self.headers.get("Authorization", "")
            supplied = header[7:] if header.startswith("Bearer ") else ""
            return authenticate(root, supplied) if supplied else None

        def valid_origin(self) -> bool:
            origin = self.headers.get("Origin")
            return origin is None or origin in allowed_origins

        def do_GET(self) -> None:
            if self.path == "/health":
                self.send_json(200, {"ok": True, "service": "memento", "version": VERSION})
            else:
                self.send_json(405 if self.path == "/mcp" else 404, {"error": "method_not_allowed" if self.path == "/mcp" else "not_found"})

        def do_POST(self) -> None:
            if self.path != "/mcp":
                self.send_json(404, {"error": "not_found"})
                return
            if not self.valid_origin():
                self.send_json(403, {"error": "origin_forbidden"})
                return
            principal = self.principal()
            if not principal:
                self.send_response(401)
                self.send_header("WWW-Authenticate", 'Bearer realm="memento"')
                self.send_header("Content-Length", "0")
                self.end_headers()
                return
            try:
                length = int(self.headers.get("Content-Length", "0"))
                if length <= 0 or length > 1_048_576:
                    raise ValueError("tamaño de solicitud inválido")
                request = json.loads(self.rfile.read(length))
                response = rpc_response(root, request, principal)
                if response is None:
                    self.send_response(202)
                    self.send_header("Content-Length", "0")
                    self.end_headers()
                else:
                    self.send_json(200, response)
            except PermissionError as exc:
                self.send_json(403, {"jsonrpc": "2.0", "id": None, "error": {"code": -32003, "message": str(exc)}})
            except (ValueError, json.JSONDecodeError) as exc:
                self.send_json(400, {"jsonrpc": "2.0", "id": None, "error": {"code": -32600, "message": str(exc)}})
            except Exception as exc:
                self.send_json(500, {"jsonrpc": "2.0", "id": None, "error": {"code": -32603, "message": str(exc)}})

        def log_message(self, fmt: str, *args: Any) -> None:
            print(f"http {self.address_string()} {fmt % args}", file=sys.stderr)

    server = ThreadingHTTPServer((host, port), Handler)
    print(f"Memento MCP escuchando en http://{host}:{server.server_port}/mcp", file=sys.stderr)
    server.serve_forever()


def parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="memento", description="Memoria Markdown para agentes, sin base de datos")
    p.add_argument("--version", action="version", version=VERSION)
    sub = p.add_subparsers(dest="command", required=True)
    for name in ("init", "doctor"):
        command = sub.add_parser(name)
        command.add_argument("--root")
    save = sub.add_parser("save")
    save.add_argument("--root")
    save.add_argument("--project", required=True)
    save.add_argument("--title", required=True)
    save.add_argument("--content")
    save.add_argument("--type", default="note")
    save.add_argument("--tags", default="")
    save.add_argument("--author")
    search = sub.add_parser("search")
    search.add_argument("query")
    search.add_argument("--root")
    search.add_argument("--project")
    search.add_argument("--limit", type=int, default=20)
    context = sub.add_parser("context")
    context.add_argument("--root")
    context.add_argument("--project", required=True)
    context.add_argument("--limit", type=int, default=20)
    for name in ("show", "delete"):
        command = sub.add_parser(name)
        command.add_argument("id")
        command.add_argument("--root")
    mcp = sub.add_parser("mcp")
    mcp.add_argument("--root")
    http = sub.add_parser("serve-http")
    http.add_argument("--root")
    http.add_argument("--host", default="127.0.0.1")
    http.add_argument("--port", type=int, default=7337)
    users = sub.add_parser("users")
    user_sub = users.add_subparsers(dest="user_command", required=True)
    add = user_sub.add_parser("add")
    add.add_argument("--root")
    add.add_argument("--username", required=True)
    add.add_argument("--role", choices=("admin", "writer", "reader"), required=True)
    add.add_argument("--projects", required=True, help="Lista separada por comas o *")
    add.add_argument("--token-file", help="Importa un token existente en vez de generar uno")
    listing = user_sub.add_parser("list")
    listing.add_argument("--root")
    revoke = user_sub.add_parser("revoke")
    revoke.add_argument("--root")
    revoke.add_argument("--username", required=True)
    return p


def main() -> int:
    args = parser().parse_args()
    root = locate_root(getattr(args, "root", None), create=args.command in ("init", "save", "mcp"))
    if args.command == "init":
        print(root)
    elif args.command == "save":
        content = args.content if args.content is not None else sys.stdin.read()
        print(json.dumps(public(save_memory(root, args.project, args.title, content, args.type, [x.strip() for x in args.tags.split(",") if x.strip()], args.author)), ensure_ascii=False, indent=2))
    elif args.command == "search":
        print(json.dumps([public(x) for x in search_memories(root, args.query, args.project, args.limit)], ensure_ascii=False, indent=2))
    elif args.command == "context":
        items = list(memory_files(root, args.project) or [])
        items.sort(key=lambda x: x.get("created_at", ""), reverse=True)
        print(json.dumps([public(x) for x in items[: args.limit]], ensure_ascii=False, indent=2))
    elif args.command == "show":
        item = find_memory(root, args.id)
        if not item:
            print(f"memoria no encontrada: {args.id}", file=sys.stderr)
            return 1
        print(json.dumps(public(item), ensure_ascii=False, indent=2))
    elif args.command == "delete":
        if not delete_memory(root, args.id):
            print(f"memoria no encontrada: {args.id}", file=sys.stderr)
            return 1
        print(args.id)
    elif args.command == "doctor":
        invalid = []
        for path in (root / "projects").rglob("*.md") if (root / "projects").exists() else []:
            try:
                decode_memory(path)
            except Exception as exc:
                invalid.append({"path": str(path), "error": str(exc)})
        print(json.dumps({"ok": not invalid, "root": str(root), "memories": sum(1 for _ in memory_files(root) or []), "invalid": invalid}, ensure_ascii=False, indent=2))
        return 0 if not invalid else 1
    elif args.command == "mcp":
        serve_mcp(root)
    elif args.command == "serve-http":
        legacy_token = os.environ.get("MEMENTO_TOKEN", "")
        if not load_users(root):
            if len(legacy_token) < 32:
                print("no hay usuarios; creá uno con memento users add", file=sys.stderr)
                return 2
            create_user(root, os.environ.get("USER", "admin"), "admin", ["*"], legacy_token)
            print("Token existente migrado como usuario administrador", file=sys.stderr)
        origins = {x.strip() for x in os.environ.get("MEMENTO_ALLOWED_ORIGINS", "").split(",") if x.strip()}
        serve_http(root, args.host, args.port, origins)
    elif args.command == "users":
        if args.user_command == "add":
            imported = Path(args.token_file).expanduser().read_text(encoding="utf-8").strip() if args.token_file else None
            raw = create_user(root, args.username, args.role, [x.strip() for x in args.projects.split(",") if x.strip()], imported)
            shown_token = "(token importado; no se vuelve a mostrar)" if imported else raw
            print(json.dumps({"username": args.username, "role": args.role, "projects": args.projects.split(","), "token": shown_token}, ensure_ascii=False, indent=2))
        elif args.user_command == "list":
            print(json.dumps([{key: value for key, value in user.items() if key != "token_hash"} for user in load_users(root)], ensure_ascii=False, indent=2))
        elif args.user_command == "revoke":
            users_data = load_users(root)
            found = False
            for user in users_data:
                if user["username"] == args.username and user.get("active", True):
                    user["active"] = False
                    user["revoked_at"] = dt.datetime.now().astimezone().isoformat(timespec="seconds")
                    found = True
            if not found:
                print("usuario activo no encontrado", file=sys.stderr)
                return 1
            write_users(root, users_data)
            audit(root, os.environ.get("USER", "local-admin"), "user.revoked", None, {"username": args.username})
            print(args.username)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
