    root = locate_root(getattr(args, "root", None), create=args.command in ("init", "save", "mcp"))
    if args.command == "init":
        print(root)
    elif args.command == "save":
        content = args.content if args.content is not None else sys.stdin.read()
        print(json.dumps(public(save_memory(root, args.project, args.title, content, args.type, [x.strip() for x in args.tags.split(",") if x.strip()], args.author)), ensure_ascii=False, indent=2))
