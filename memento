def mcp_call(root: Path, name: str, args: dict[str, Any], principal: dict[str, Any] | None = None) -> Any:
    user = principal or {"username": "local", "role": "admin", "projects": ["*"]}
    if name == "activity_add":
        require_access(user, args["project"], write=True)
        item = save_memory(root, args["project"], args["action"], args["details"], "activity", args.get("tags", []), user["username"])
        record_event(root, item)
        audit(root, user["username"], "activity.add", args["project"], {"id": item["id"], "action": args["action"]})
        return public(item)
    if name in ("activity_list", "activity_search"):
        require_access(user, args["project"])
        query = args.get("query", "") if name == "activity_search" else ""
        items = search_memories(root, query, args["project"], args.get("limit", 20))
        items = [item for item in items if item.get("type") == "activity" and (not args.get("actor") or item.get("author") == args["actor"])]
        return [public(x) for x in items[: args.get("limit", 20)]]
    if name == "task_create":
        require_access(user, args["project"], write=True)
        envelope = create_task(root, user["username"], args["executor"], args["project"], args["trigger"], args["action"], args.get("catch_up", "execute"))
        audit(root, user["username"], "task.created", args["project"], {"task_id": envelope["task_id"], "executor": args["executor"]})
        return envelope
    if name == "task_import":
        spec = args["task"].get("spec", {})
        require_access(user, spec.get("project", ""), write=True)
        return import_task(root, args["task"])
    if name == "task_approve":
        envelope = next((task for task in load_tasks(root) if task["task_id"] == args["task_id"]), None)
        if not envelope:
            raise ValueError("tarea no encontrada")
        require_access(user, envelope["spec"]["project"], admin=True)
        if envelope["spec"]["executor"] != node_id(root):
            raise PermissionError("sólo el nodo ejecutor puede aprobar esta tarea")
        return {"task_id": args["task_id"], "approved": approve_task(root, args["task_id"], user["username"])}
    if name == "task_list":
        project = args.get("project")
        if project:
            require_access(user, project)
        directories = task_dirs(root)
        result = []
        for envelope in load_tasks(root):
            spec = envelope["spec"]
            if (not project or spec["project"] == project) and project_allowed(user, spec["project"]):
                result.append({**envelope, "approved": (directories["approvals"] / f"{envelope['task_id']}.json").exists(), "cancelled": (directories["cancellations"] / f"{envelope['task_id']}.json").exists()})
        return result
    if name == "task_cancel":
        envelope = next((task for task in load_tasks(root) if task["task_id"] == args["task_id"]), None)
        if not envelope:
            raise ValueError("tarea no encontrada")
        require_access(user, envelope["spec"]["project"], admin=True)
        return {"task_id": args["task_id"], "cancelled": cancel_task(root, args["task_id"], user["username"])}
    if name == "task_run_due":
        if user["role"] != "admin":
            raise PermissionError("se requiere rol admin")
        return run_due_tasks(root)
    if name == "event_list":
        project = args.get("project")
        if project:
            require_access(user, project)
        return [event for event in load_events(root) if (not project or event["project"] == project) and project_allowed(user, event["project"])]
    if name == "event_import":
        require_access(user, args["event"].get("project", ""), write=True)
        return {"event_id": args["event"].get("event_id"), "imported": import_event(root, args["event"])}
    if name == "peer_list":
        return [{key: value for key, value in peer.items() if key != "token_file"} for peer in load_peers(root)]
    if name == "peer_sync":
        if user["role"] != "admin":
            raise PermissionError("se requiere rol admin")
        return peer_cycle(root)
    if name == "inbox_list":
        return [item for item in inbox_items(root, args.get("include_acknowledged", False)) if project_allowed(user, item["project"])]
    if name == "inbox_ack":
        item = next((item for item in inbox_items(root, True) if item["notification_id"] == args["notification_id"]), None)
        if not item:
            raise ValueError("notificación no encontrada")
        require_access(user, item["project"])
        return {"notification_id": args["notification_id"], "acknowledged": acknowledge_notification(root, args["notification_id"], user["username"])}
    if name == "memory_save":
        require_access(user, args["project"], write=True)
        return public(save_memory(root, args["project"], args["title"], args["content"], args.get("type", "note"), args.get("tags", []), user["username"]))
    if name == "memory_search":
        project = args.get("project")
        if project:
            require_access(user, project)
        items = search_memories(root, args["query"], project, args.get("limit", 20))
        return [public(x) for x in items if project_allowed(user, x["project"])]
    if name == "memory_get":
        item = find_memory(root, args["id"])
        if item:
            require_access(user, item["project"])
        return public(item) if item else None
    if name == "memory_context":
        require_access(user, args["project"])
        items = list(memory_files(root, args["project"]) or [])
        items.sort(key=lambda x: x.get("created_at", ""), reverse=True)
        return [public(x) for x in items[: args.get("limit", 20)]]
    if name == "memory_delete":
        item = find_memory(root, args["id"])
        if item:
            require_access(user, item["project"], admin=True)
        return {"deleted": delete_memory(root, args["id"])}
    raise ValueError(f"herramienta desconocida: {name}")


def rpc_response(root: Path, request: dict[str, Any], principal: dict[str, Any] | None = None) -> dict[str, Any] | None:
    if "id" not in request:
        return None
    method = request.get("method")
    if method == "initialize":
        requested = request.get("params", {}).get("protocolVersion", "2025-06-18")
        protocol = requested if requested in ("2024-11-05", "2025-03-26", "2025-06-18") else "2025-06-18"
        result = {"protocolVersion": protocol, "capabilities": {"tools": {}}, "serverInfo": {"name": "memento", "version": VERSION}}
    elif method == "tools/list":
        result = {"tools": TOOLS}
    elif method == "tools/call":
        params = request.get("params", {})
        value = mcp_call(root, params.get("name", ""), params.get("arguments", {}), principal)
        result = {"content": [{"type": "text", "text": json.dumps(value, ensure_ascii=False)}]}
    elif method == "ping":
        result = {}
    else:
        raise ValueError(f"método desconocido: {method}")
    return {"jsonrpc": "2.0", "id": request["id"], "result": result}


def serve_mcp(root: Path) -> None:
    principal = None
    if load_users(root):
        principal = authenticate(root, os.environ.get("MEMENTO_TOKEN", ""))
        if not principal:
            raise SystemExit("MEMENTO_TOKEN ausente o inválido para este almacén")
    for line in sys.stdin:
        request: dict[str, Any] = {}
        try:
            request = json.loads(line)
            response = rpc_response(root, request, principal)
            if response is None:
                continue
        except Exception as exc:
            response = {"jsonrpc": "2.0", "id": request.get("id") if isinstance(request, dict) else None, "error": {"code": -32603, "message": str(exc)}}
        print(json.dumps(response, ensure_ascii=False), flush=True)


def serve_http(root: Path, host: str, port: int, allowed_origins: set[str]) -> None:
    class Handler(BaseHTTPRequestHandler):
        server_version = "Memento/" + VERSION

        def send_json(self, status: int, value: Any) -> None:
            body = json.dumps(value, ensure_ascii=False).encode("utf-8")
            self.send_response(status)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def principal(self) -> dict[str, Any] | None:
            header = self.headers.get("Authorization", "")
            supplied = header[7:] if header.startswith("Bearer ") else ""
            return authenticate(root, supplied) if supplied else None

        def valid_origin(self) -> bool:
            origin = self.headers.get("Origin")
            return origin is None or origin in allowed_origins

        def do_GET(self) -> None:
            if self.path == "/health":
                self.send_json(200, {"ok": True, "service": "memento", "version": VERSION})
            elif self.path == "/peer/snapshot":
                principal = self.principal()
                if not principal:
                    self.send_response(401)
                    self.send_header("WWW-Authenticate", 'Bearer realm="memento"')
                    self.send_header("Content-Length", "0")
                    self.end_headers()
                    return
                self.send_json(200, peer_snapshot(root, principal))
            else:
                self.send_json(405 if self.path == "/mcp" else 404, {"error": "method_not_allowed" if self.path == "/mcp" else "not_found"})

        def do_POST(self) -> None:
            if self.path != "/mcp":
                self.send_json(404, {"error": "not_found"})
                return
            if not self.valid_origin():
                self.send_json(403, {"error": "origin_forbidden"})
                return
            principal = self.principal()
            if not principal:
                self.send_response(401)
                self.send_header("WWW-Authenticate", 'Bearer realm="memento"')
                self.send_header("Content-Length", "0")
                self.end_headers()
                return
            try:
                length = int(self.headers.get("Content-Length", "0"))
                if length <= 0 or length > 1_048_576:
                    raise ValueError("tamaño de solicitud inválido")
                request = json.loads(self.rfile.read(length))
                response = rpc_response(root, request, principal)
                if response is None:
                    self.send_response(202)
                    self.send_header("Content-Length", "0")
                    self.end_headers()
                else:
                    self.send_json(200, response)
            except PermissionError as exc:
                self.send_json(403, {"jsonrpc": "2.0", "id": None, "error": {"code": -32003, "message": str(exc)}})
            except (ValueError, json.JSONDecodeError) as exc:
                self.send_json(400, {"jsonrpc": "2.0", "id": None, "error": {"code": -32600, "message": str(exc)}})
            except Exception as exc:
                self.send_json(500, {"jsonrpc": "2.0", "id": None, "error": {"code": -32603, "message": str(exc)}})

        def log_message(self, fmt: str, *args: Any) -> None:
            print(f"http {self.address_string()} {fmt % args}", file=sys.stderr)

    server = ThreadingHTTPServer((host, port), Handler)
    interval = max(0.0, float(os.environ.get("MEMENTO_PEER_SYNC_INTERVAL", "30")))

    def background_sync() -> None:
        while True:
            try:
                cycle = peer_cycle(root)
                if cycle["sync"]["synced"] or cycle["sync"]["failed"] or cycle["execution"]["executed"]:
                    print("peer " + json.dumps(cycle, ensure_ascii=False), file=sys.stderr)
            except Exception as exc:
                print(f"peer cycle error: {exc}", file=sys.stderr)
            if interval <= 0:
                return
            time.sleep(interval)

    threading.Thread(target=background_sync, name="memento-peer-sync", daemon=True).start()
    print(f"Memento MCP escuchando en http://{host}:{server.server_port}/mcp", file=sys.stderr)
    server.serve_forever()


