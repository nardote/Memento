            print(json.dumps({"notification_id": args.notification_id, "acknowledged": acknowledge_notification(root, args.notification_id, os.environ.get("USER", "local"))}, ensure_ascii=False, indent=2))
    elif args.command == "peers":
        if args.peer_command == "add":
            print(json.dumps(add_peer(root, args.name, args.url, args.token_file), ensure_ascii=False, indent=2))
        elif args.peer_command == "list":
            print(json.dumps([{key: value for key, value in peer.items() if key != "token_file"} for peer in load_peers(root)], ensure_ascii=False, indent=2))
        else:
            print(json.dumps(peer_cycle(root), ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
