VERSION = "0.1.0"
CROCKFORD = "0123456789ABCDEFGHJKMNPQRSTVWXYZ"


def ulid() -> str:
    value = (int(dt.datetime.now(dt.timezone.utc).timestamp() * 1000) << 80) | secrets.randbits(80)
    chars = []
    for _ in range(26):
        chars.append(CROCKFORD[value & 31])
        value >>= 5
    return "".join(reversed(chars))


def slugify(value: str) -> str:
    value = value.lower().strip()
    value = re.sub(r"[^a-z0-9]+", "-", value).strip("-")
    return value[:60] or "memory"


def locate_root(explicit: str | None = None, create: bool = False) -> Path:
    if explicit:
        root = Path(explicit).expanduser().resolve()
    elif os.environ.get("MEMENTO_HOME"):
        root = Path(os.environ["MEMENTO_HOME"]).expanduser().resolve()
    else:
        current = Path.cwd().resolve()
        root = next((p / ".memory" for p in (current, *current.parents) if (p / ".memory").is_dir()), current / ".memory")
    if create:
        (root / "projects").mkdir(parents=True, exist_ok=True)
        (root / "deleted").mkdir(parents=True, exist_ok=True)
        config = root / "config.json"
        if not config.exists():
            config.write_text(json.dumps({"version": 1}, indent=2) + "\n", encoding="utf-8")
    return root


def encode_memory(meta: dict[str, Any], content: str) -> str:
    return "---\n" + json.dumps(meta, ensure_ascii=False, indent=2) + "\n---\n\n" + content.strip() + "\n"


def decode_memory(path: Path) -> dict[str, Any]:
    raw = path.read_text(encoding="utf-8")
    match = re.match(r"^---\n(.*?)\n---\n\n?(.*)$", raw, re.DOTALL)
    if not match:
        raise ValueError(f"formato inválido: {path}")
    meta = json.loads(match.group(1))
    meta["content"] = match.group(2).rstrip()
    meta["path"] = str(path)
    return meta


def memory_files(root: Path, project: str | None = None):
    base = root / "projects"
    if project:
        base = base / project
    if not base.exists():
        return
    deleted = {p.name for p in (root / "deleted").glob("*")}
    for path in base.rglob("*.md"):
        try:
            item = decode_memory(path)
            if item.get("id") not in deleted:
                yield item
        except (ValueError, OSError, json.JSONDecodeError):
            continue


def save_memory(root: Path, project: str, title: str, content: str, kind: str = "note", tags=None, author=None) -> dict[str, Any]:
    root = locate_root(str(root), create=True)
    now = dt.datetime.now().astimezone()
    memory_id = ulid()
    meta = {
        "id": memory_id,
        "project": project,
        "type": kind,
        "title": title,
        "created_at": now.isoformat(timespec="seconds"),
        "author": author or os.environ.get("USER", "unknown"),
        "tags": tags or [],
    }
    directory = root / "projects" / project / now.strftime("%Y") / now.strftime("%m")
    directory.mkdir(parents=True, exist_ok=True)
    path = directory / f"{memory_id}-{slugify(title)}.md"
    path.write_text(encode_memory(meta, content), encoding="utf-8")
    return decode_memory(path)


def search_memories(root: Path, query: str, project: str | None = None, limit: int = 20) -> list[dict[str, Any]]:
    terms = [term.casefold() for term in query.split() if term]
    found = []
    for item in memory_files(root, project) or []:
        haystack = " ".join([item.get("title", ""), item.get("content", ""), " ".join(item.get("tags", []))]).casefold()
        score = sum(haystack.count(term) for term in terms)
        if not terms or score:
            item["score"] = score
            found.append(item)
    found.sort(key=lambda x: (x["score"], x.get("created_at", "")), reverse=True)
    return found[:limit]


def find_memory(root: Path, memory_id: str) -> dict[str, Any] | None:
    return next((item for item in memory_files(root) or [] if item.get("id") == memory_id), None)


def delete_memory(root: Path, memory_id: str) -> bool:
    if not find_memory(root, memory_id):
        return False
    deleted = root / "deleted"
    deleted.mkdir(parents=True, exist_ok=True)
    (deleted / memory_id).write_text(dt.datetime.now().astimezone().isoformat() + "\n", encoding="utf-8")
    return True


def token_hash(token: str) -> str:
    return "sha256:" + hashlib.sha256(token.encode("utf-8")).hexdigest()


def users_path(root: Path) -> Path:
    return root / "users.json"


def load_users(root: Path) -> list[dict[str, Any]]:
    path = users_path(root)
    if not path.exists():
        return []
    data = json.loads(path.read_text(encoding="utf-8"))
    return data.get("users", [])


def write_users(root: Path, users: list[dict[str, Any]]) -> None:
    locate_root(str(root), create=True)
    path = users_path(root)
    temporary = path.with_suffix(".tmp")
    temporary.write_text(json.dumps({"version": 1, "users": users}, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    os.chmod(temporary, 0o600)
    temporary.replace(path)


def create_user(root: Path, username: str, role: str, projects: list[str], token: str | None = None) -> str:
    if role not in ("admin", "writer", "reader"):
        raise ValueError("rol inválido")
    if not re.fullmatch(r"[a-zA-Z0-9_.-]{1,64}", username):
        raise ValueError("nombre de usuario inválido")
    users = load_users(root)
    if any(user["username"] == username and user.get("active", True) for user in users):
        raise ValueError("el usuario ya existe")
    raw = token or secrets.token_urlsafe(48)
    if len(raw) < 32:
        raise ValueError("el token debe tener al menos 32 caracteres")
    users.append({
        "username": username,
        "role": role,
        "projects": projects or [],
        "token_hash": token_hash(raw),
        "active": True,
        "created_at": dt.datetime.now().astimezone().isoformat(timespec="seconds"),
    })
    write_users(root, users)
    audit(root, username, "user.created", None, {"role": role, "projects": projects})
    return raw


def authenticate(root: Path, token: str) -> dict[str, Any] | None:
    digest = token_hash(token)
    for user in load_users(root):
        if user.get("active", True) and hmac.compare_digest(user.get("token_hash", ""), digest):
            return user
    return None


def project_allowed(user: dict[str, Any], project: str) -> bool:
    return "*" in user.get("projects", []) or project in user.get("projects", [])


def require_access(user: dict[str, Any], project: str, write: bool = False, admin: bool = False) -> None:
    if admin and user.get("role") != "admin":
        raise PermissionError("se requiere rol admin")
    if write and user.get("role") not in ("admin", "writer"):
        raise PermissionError("el usuario es de sólo lectura")
    if not project_allowed(user, project):
        raise PermissionError(f"sin acceso al proyecto: {project}")


def audit(root: Path, actor: str, action: str, project: str | None, details: dict[str, Any]) -> None:
    now = dt.datetime.now().astimezone()
    directory = root / "audit"
    directory.mkdir(parents=True, exist_ok=True)
    event = {"id": ulid(), "timestamp": now.isoformat(timespec="seconds"), "actor": actor, "action": action, "project": project, "details": details}
    with (directory / now.strftime("%Y-%m.jsonl")).open("a", encoding="utf-8") as stream:
        stream.write(json.dumps(event, ensure_ascii=False) + "\n")


def canonical_json(value: Any) -> str:
    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"))


def content_id(prefix: str, value: Any) -> str:
    digest = hashlib.sha256(canonical_json(value).encode("utf-8")).hexdigest()
    return f"{prefix}_{digest}"


def task_dirs(root: Path) -> dict[str, Path]:
    directories = {
        "specs": root / "tasks" / "specs",
        "approvals": root / "tasks" / "approvals",
        "cancellations": root / "tasks" / "cancellations",
        "receipts": root / "tasks" / "receipts",
        "events": root / "events",
        "inbox": root / "inbox",
        "acknowledged": root / "inbox" / "acknowledged",
    }
    for directory in directories.values():
        directory.mkdir(parents=True, exist_ok=True)
    return directories


def node_id(root: Path) -> str:
    locate_root(str(root), create=True)
    config_path = root / "config.json"
    config = json.loads(config_path.read_text(encoding="utf-8"))
    if not config.get("node_id"):
        config["node_id"] = "node-" + secrets.token_hex(8)
        config_path.write_text(json.dumps(config, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    return config["node_id"]


def set_node_id(root: Path, value: str) -> None:
    if not re.fullmatch(r"[a-zA-Z0-9_.-]{1,64}", value):
        raise ValueError("node_id inválido")
    locate_root(str(root), create=True)
    config_path = root / "config.json"
    config = json.loads(config_path.read_text(encoding="utf-8"))
    config["node_id"] = value
    config_path.write_text(json.dumps(config, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")


def write_once(path: Path, value: Any) -> bool:
    path.parent.mkdir(parents=True, exist_ok=True)
    encoded = json.dumps(value, ensure_ascii=False, indent=2) + "\n"
    try:
        descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    except FileExistsError:
        return False
    with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
        stream.write(encoded)
    return True


def create_task(root: Path, creator: str, executor: str, project: str, trigger: dict[str, Any], action: dict[str, Any], catch_up: str = "execute", created_at: str | None = None) -> dict[str, Any]:
    if trigger.get("type") not in ("event", "at"):
        raise ValueError("trigger soportado: event o at")
    if action.get("type") != "notify":
        raise ValueError("acción soportada: notify")
    if catch_up not in ("execute", "skip", "expire"):
        raise ValueError("catch_up inválido")
    spec = {
        "version": 1,
        "creator": creator,
        "executor": executor,
        "project": project,
        "trigger": trigger,
        "action": action,
        "catch_up": catch_up,
        "created_at": created_at or dt.datetime.now().astimezone().isoformat(timespec="seconds"),
    }
    task_id = content_id("task", spec)
    envelope = {"task_id": task_id, "spec": spec}
    write_once(task_dirs(root)["specs"] / f"{task_id}.json", envelope)
    return envelope


def import_task(root: Path, envelope: dict[str, Any]) -> dict[str, Any]:
    spec = envelope.get("spec", {})
    expected = content_id("task", spec)
    if envelope.get("task_id") != expected:
        raise ValueError("hash de tarea inválido")
    if spec.get("trigger", {}).get("type") not in ("event", "at") or spec.get("action", {}).get("type") != "notify":
        raise ValueError("tarea contiene trigger o acción no soportada")
    created = write_once(task_dirs(root)["specs"] / f"{expected}.json", envelope)
    return {"task_id": expected, "imported": created, "status": "pending_approval"}


def load_tasks(root: Path) -> list[dict[str, Any]]:
    result = []
    for path in task_dirs(root)["specs"].glob("task_*.json"):
        try:
            envelope = json.loads(path.read_text(encoding="utf-8"))
            if envelope.get("task_id") == content_id("task", envelope.get("spec", {})):
                result.append(envelope)
        except (OSError, json.JSONDecodeError):
            continue
    result.sort(key=lambda item: item["spec"].get("created_at", ""))
    return result


def approve_task(root: Path, task_id: str, actor: str) -> bool:
    if not (task_dirs(root)["specs"] / f"{task_id}.json").exists():
        raise ValueError("tarea no encontrada")
    approval = {"task_id": task_id, "approved_by": actor, "approved_at": dt.datetime.now().astimezone().isoformat(timespec="seconds")}
    return write_once(task_dirs(root)["approvals"] / f"{task_id}.json", approval)


def cancel_task(root: Path, task_id: str, actor: str) -> bool:
    cancellation = {"task_id": task_id, "cancelled_by": actor, "cancelled_at": dt.datetime.now().astimezone().isoformat(timespec="seconds")}
    return write_once(task_dirs(root)["cancellations"] / f"{task_id}.json", cancellation)


def record_event(root: Path, activity: dict[str, Any]) -> dict[str, Any]:
    event = {
        "event_id": "event_" + activity["id"],
        "project": activity["project"],
        "activity_id": activity["id"],
        "occurred_at": activity["created_at"],
        "title": activity["title"],
        "content": activity["content"],
        "tags": activity.get("tags", []),
        "actor": activity.get("author"),
    }
    write_once(task_dirs(root)["events"] / f"{event['event_id']}.json", event)
    return event


def load_events(root: Path) -> list[dict[str, Any]]:
    events = []
    for path in task_dirs(root)["events"].glob("event_*.json"):
        try:
            events.append(json.loads(path.read_text(encoding="utf-8")))
        except (OSError, json.JSONDecodeError):
            continue
    events.sort(key=lambda event: event.get("occurred_at", ""))
    return events


def import_event(root: Path, event: dict[str, Any]) -> bool:
    event_id = event.get("event_id", "")
    if not re.fullmatch(r"event_[A-Z0-9]{26}", event_id):
        raise ValueError("event_id inválido")
    required = ("project", "activity_id", "occurred_at", "title", "content", "tags")
    if any(key not in event for key in required):
        raise ValueError("evento incompleto")
    dt.datetime.fromisoformat(event["occurred_at"])
    return write_once(task_dirs(root)["events"] / f"{event_id}.json", event)


def event_matches(spec: dict[str, Any], event: dict[str, Any]) -> bool:
    trigger = spec["trigger"]
    if event.get("project") != spec.get("project"):
        return False
    if not trigger.get("include_existing", False) and event.get("occurred_at", "") < spec.get("created_at", ""):
        return False
    filters = trigger.get("filters", {})
    tags = set(event.get("tags", []))
    if not set(filters.get("tags_all", [])).issubset(tags):
        return False
    any_tags = set(filters.get("tags_any", []))
    if any_tags and not any_tags.intersection(tags):
        return False
    text = filters.get("text", "").casefold().strip()
    haystack = f"{event.get('title', '')} {event.get('content', '')}".casefold()
    return not text or text in haystack


def due_instances(root: Path, envelope: dict[str, Any], now: dt.datetime) -> list[dict[str, Any]]:
    spec = envelope["spec"]
    trigger = spec["trigger"]
    if trigger["type"] == "event":
        result = []
        for event in load_events(root):
            if event_matches(spec, event):
                result.append({"instance_id": event["event_id"], "event": event})
        return result
    scheduled = dt.datetime.fromisoformat(trigger["at"])
    if scheduled.tzinfo is None:
        raise ValueError("trigger.at debe incluir zona horaria")
    if now < scheduled:
        return []
    catch_up = spec.get("catch_up", "execute")
    if catch_up == "skip" and now > scheduled:
        return []
    if catch_up == "expire":
        grace = int(trigger.get("grace_period_seconds", 0))
        if now > scheduled + dt.timedelta(seconds=grace):
            return []
    return [{"instance_id": "at_" + scheduled.isoformat(), "scheduled_at": scheduled.isoformat()}]


def run_due_tasks(root: Path, current_node: str | None = None, now: dt.datetime | None = None) -> dict[str, Any]:
    current_node = current_node or node_id(root)
    now = now or dt.datetime.now().astimezone()
    directories = task_dirs(root)
    result = {"node_id": current_node, "evaluated": 0, "executed": 0, "skipped": 0, "receipts": []}
    for envelope in load_tasks(root):
        task_id = envelope["task_id"]
        spec = envelope["spec"]
        if spec.get("executor") != current_node:
            continue
        result["evaluated"] += 1
        if not (directories["approvals"] / f"{task_id}.json").exists() or (directories["cancellations"] / f"{task_id}.json").exists():
            result["skipped"] += 1
            continue
        for instance in due_instances(root, envelope, now):
            execution_id = content_id("exec", {"task_id": task_id, "instance_id": instance["instance_id"]})
            receipt_path = directories["receipts"] / f"{execution_id}.json"
            if receipt_path.exists():
                result["skipped"] += 1
                continue
            inbox_item = {
                "notification_id": execution_id,
                "task_id": task_id,
                "trigger_instance": instance["instance_id"],
                "project": spec["project"],
                "title": spec["action"].get("title", "Memento notification"),
                "message": spec["action"].get("message", "A replicated task was triggered."),
                "created_at": now.isoformat(timespec="seconds"),
                "event": instance.get("event"),
            }
            write_once(directories["inbox"] / f"{execution_id}.json", inbox_item)
            receipt = {"execution_id": execution_id, "task_id": task_id, "trigger_instance": instance["instance_id"], "executor": current_node, "status": "succeeded", "executed_at": now.isoformat(timespec="seconds")}
            if write_once(receipt_path, receipt):
                result["executed"] += 1
                result["receipts"].append(receipt)
    return result


def inbox_items(root: Path, include_acknowledged: bool = False) -> list[dict[str, Any]]:
    directories = task_dirs(root)
    acknowledged = {path.stem for path in directories["acknowledged"].glob("exec_*.json")}
    items = []
    for path in directories["inbox"].glob("exec_*.json"):
        item = json.loads(path.read_text(encoding="utf-8"))
        item["acknowledged"] = item["notification_id"] in acknowledged
        if include_acknowledged or not item["acknowledged"]:
            items.append(item)
    items.sort(key=lambda item: item.get("created_at", ""), reverse=True)
    return items


def acknowledge_notification(root: Path, notification_id: str, actor: str) -> bool:
    if not (task_dirs(root)["inbox"] / f"{notification_id}.json").exists():
        raise ValueError("notificación no encontrada")
    value = {"notification_id": notification_id, "acknowledged_by": actor, "acknowledged_at": dt.datetime.now().astimezone().isoformat(timespec="seconds")}
    return write_once(task_dirs(root)["acknowledged"] / f"{notification_id}.json", value)


def peers_dir(root: Path) -> Path:
    directory = root / "peers"
    directory.mkdir(parents=True, exist_ok=True)
    return directory


def add_peer(root: Path, name: str, url: str, token_file: str) -> dict[str, Any]:
    if not re.fullmatch(r"[a-zA-Z0-9_.-]{1,64}", name):
        raise ValueError("nombre de peer inválido")
    parsed = urllib.parse.urlparse(url)
    if parsed.scheme not in ("http", "https") or not parsed.netloc:
        raise ValueError("URL de peer inválida")
    if parsed.scheme == "http" and parsed.hostname not in ("127.0.0.1", "localhost", "::1"):
        raise ValueError("peers remotos requieren HTTPS")
    token_path = Path(token_file).expanduser().resolve()
    if not token_path.is_file():
        raise ValueError("token_file no existe")
    peer = {"name": name, "url": url.rstrip("/"), "token_file": str(token_path), "created_at": dt.datetime.now().astimezone().isoformat(timespec="seconds")}
    path = peers_dir(root) / f"{name}.json"
    path.write_text(json.dumps(peer, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    os.chmod(path, 0o600)
    return {key: value for key, value in peer.items() if key != "token_file"}


def load_peers(root: Path) -> list[dict[str, Any]]:
    peers = []
    for path in peers_dir(root).glob("*.json"):
        try:
            peers.append(json.loads(path.read_text(encoding="utf-8")))
        except (OSError, json.JSONDecodeError):
            continue
    return sorted(peers, key=lambda peer: peer.get("name", ""))


def json_files(directory: Path, pattern: str) -> list[dict[str, Any]]:
    result = []
    for path in directory.glob(pattern):
        try:
            result.append(json.loads(path.read_text(encoding="utf-8")))
        except (OSError, json.JSONDecodeError):
            continue
    return result


def peer_snapshot(root: Path, principal: dict[str, Any]) -> dict[str, Any]:
    directories = task_dirs(root)
    tasks = [task for task in load_tasks(root) if project_allowed(principal, task["spec"]["project"])]
    task_projects = {task["task_id"]: task["spec"]["project"] for task in tasks}
    events = [event for event in load_events(root) if project_allowed(principal, event["project"])]
    cancellations = [item for item in json_files(directories["cancellations"], "task_*.json") if item.get("task_id") in task_projects]
    receipts = [item for item in json_files(directories["receipts"], "exec_*.json") if item.get("task_id") in task_projects]
    return {"node_id": node_id(root), "generated_at": dt.datetime.now().astimezone().isoformat(timespec="seconds"), "tasks": tasks, "events": events, "cancellations": cancellations, "receipts": receipts}


def import_cancellation(root: Path, cancellation: dict[str, Any]) -> bool:
    task_id = cancellation.get("task_id", "")
    if not re.fullmatch(r"task_[a-f0-9]{64}", task_id):
        raise ValueError("cancelación inválida")
    return write_once(task_dirs(root)["cancellations"] / f"{task_id}.json", cancellation)


def import_receipt(root: Path, receipt: dict[str, Any]) -> bool:
    expected = content_id("exec", {"task_id": receipt.get("task_id"), "instance_id": receipt.get("trigger_instance")})
    if receipt.get("execution_id") != expected:
        raise ValueError("receipt inválido")
    return write_once(task_dirs(root)["receipts"] / f"{expected}.json", receipt)


def sync_peer(root: Path, peer: dict[str, Any], timeout: float = 5.0) -> dict[str, Any]:
    token = Path(peer["token_file"]).read_text(encoding="utf-8").strip()
    request = urllib.request.Request(peer["url"] + "/peer/snapshot", headers={"Authorization": "Bearer " + token, "Accept": "application/json"})
    with urllib.request.urlopen(request, timeout=timeout) as response:
        maximum = int(os.environ.get("MEMENTO_PEER_MAX_BYTES", "8388608"))
        body = response.read(maximum + 1)
        if len(body) > maximum:
            raise ValueError("snapshot de peer excede el límite")
        snapshot = json.loads(body)
    result = {"peer": peer["name"], "remote_node": snapshot.get("node_id"), "tasks": 0, "events": 0, "cancellations": 0, "receipts": 0}
    for task in snapshot.get("tasks", []):
        if import_task(root, task)["imported"]:
            result["tasks"] += 1
    for event in snapshot.get("events", []):
        if import_event(root, event):
            result["events"] += 1
    for cancellation in snapshot.get("cancellations", []):
        if import_cancellation(root, cancellation):
            result["cancellations"] += 1
    for receipt in snapshot.get("receipts", []):
        if import_receipt(root, receipt):
            result["receipts"] += 1
    return result


def sync_all_peers(root: Path, timeout: float = 5.0) -> dict[str, Any]:
    result = {"synced": [], "failed": []}
    for peer in load_peers(root):
        try:
            result["synced"].append(sync_peer(root, peer, timeout))
        except Exception as exc:
            result["failed"].append({"peer": peer.get("name"), "error": str(exc)})
    return result


def peer_cycle(root: Path) -> dict[str, Any]:
    sync = sync_all_peers(root)
    execution = run_due_tasks(root)
    return {"sync": sync, "execution": execution}


def public(item: dict[str, Any]) -> dict[str, Any]:
