        if not delete_memory(root, args.id):
            print(f"memoria no encontrada: {args.id}", file=sys.stderr)
            return 1
        print(args.id)
    elif args.command == "doctor":
        invalid = []
        for path in (root / "projects").rglob("*.md") if (root / "projects").exists() else []:
            try:
                decode_memory(path)
            except Exception as exc:
                invalid.append({"path": str(path), "error": str(exc)})
        print(json.dumps({"ok": not invalid, "root": str(root), "memories": sum(1 for _ in memory_files(root) or []), "invalid": invalid}, ensure_ascii=False, indent=2))
        return 0 if not invalid else 1
    elif args.command == "mcp":
        serve_mcp(root)
