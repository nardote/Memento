            values = [{**task, "approved": (directories["approvals"] / f"{task['task_id']}.json").exists(), "cancelled": (directories["cancellations"] / f"{task['task_id']}.json").exists()} for task in load_tasks(root)]
            print(json.dumps(values, ensure_ascii=False, indent=2))
